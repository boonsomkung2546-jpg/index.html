    function playChordRowAudio(chordRowId) {
      if (!state.chordSoundEnabled) return;
      const row = state.chordRows.find(r => r.id === chordRowId);
      if (!row || !row.cells || row.cells.length === 0) return;

      stopScaleAudioSequence();
      const ctx = ensureAudio();
      const mode = state.chordSoundMode || 'arpeggio';

      const triggerNotesAt = (offsetSec, durSec) => {
        row.cells.forEach(cell => {
          const tId = setTimeout(() => {
            const btnEl = document.querySelector(`[data-cell-id="${cell.id}"]`);
            if (btnEl) {
              btnEl.classList.add('cell-playing-note');
              setTimeout(() => btnEl.classList.remove('cell-playing-note'), Math.min(450, durSec * 900));
            }
            const now = ctx.currentTime;
            const freq = 440 * Math.pow(2, (cell.midi - 69) / 12);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.001, now);
            gain.gain.linearRampToValueAtTime(0.22, now + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + durSec);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + durSec + 0.02);
          }, Math.max(0, offsetSec * 1000));
          state.playbackTimers.push(tId);
        });
      };

      if (mode === 'block') {
        triggerNotesAt(0, 0.65);
      } else if (mode === 'both') {
        row.cells.forEach((cell, idx) => {
          const tId = setTimeout(() => {
            document.querySelectorAll('.cell-playing-note').forEach(el => el.classList.remove('cell-playing-note'));
            const btnEl = document.querySelector(`[data-cell-id="${cell.id}"]`);
            if (btnEl) btnEl.classList.add('cell-playing-note');
            playSingleMidi(cell.midi, 0.32);
          }, idx * 240);
          state.playbackTimers.push(tId);
        });
        const afterArpSec = (row.cells.length * 240) / 1000 + 0.15;
        triggerNotesAt(afterArpSec, 0.65);
      } else {
        row.cells.forEach((cell, idx) => {
          const tId = setTimeout(() => {
            document.querySelectorAll('.cell-playing-note').forEach(el => el.classList.remove('cell-playing-note'));
            const btnEl = document.querySelector(`[data-cell-id="${cell.id}"]`);
            if (btnEl) btnEl.classList.add('cell-playing-note');
            playSingleMidi(cell.midi, 0.34);
          }, idx * 250);
          state.playbackTimers.push(tId);
        });
      }
    }

    function formatChordSymbolByStyle(chordDef) {
      const majMode = (document.getElementById('chordStyleMajorSelect') && document.getElementById('chordStyleMajorSelect').value) || 'tri_symbol';
      const minMode = (document.getElementById('chordStyleMinorSelect') && document.getElementById('chordStyleMinorSelect').value) || 'minus';
      const augMode = (document.getElementById('chordStyleAugSelect') && document.getElementById('chordStyleAugSelect').value) || 'plus';
      const dimMode = (document.getElementById('chordStyleDimSelect') && document.getElementById('chordStyleDimSelect').value) || 'deg';

      if (chordDef.id === 'tri_maj') {
        return majMode === 'tri_symbol' ? '△' : '';
      }
      if (chordDef.id === 'sev_maj7') {
        return majMode === 'tri_symbol' ? '△7' : 'maj7';
      }
      if (chordDef.id === 'tri_min') {
        return minMode === 'minus' ? '-' : 'm';
      }
      if (chordDef.id === 'sev_min7') {
        return minMode === 'minus' ? '-7' : 'm7';
      }
      if (chordDef.id === 'sev_mm7') {
        return minMode === 'minus' ? '-(△7)' : 'm(maj7)';
      }
      if (chordDef.id === 'tri_aug') {
        return augMode === 'plus' ? '+' : 'aug';
      }
      if (chordDef.id === 'tri_dim') {
        return dimMode === 'deg' ? '°' : 'dim';
      }
      return chordDef.symbol || '';
    }

    function getSelectedChordSpecs() {
      const specs = [];
      const addIf = (chkId, catId) => {
        const el = document.getElementById(chkId);
        if (el && el.checked) {
          const found = CHORD_CATALOG.find(c => c.id === catId);
          if (found) specs.push(found);
        }
      };
      addIf('chkTriadMajor', 'tri_maj');
      addIf('chkTriadMinor', 'tri_min');
      addIf('chkTriadDim', 'tri_dim');
      addIf('chkTriadAug', 'tri_aug');
      addIf('chkSeventhMaj7', 'sev_maj7');
      addIf('chkSeventhDom7', 'sev_dom7');
      addIf('chkSeventhMin7', 'sev_min7');
      addIf('chkSeventhMinMaj7', 'sev_mm7');
      return specs;
    }

    function invertSemitoneSteps(steps, invIdx) {
      const arr = steps.slice();
      const k = ((invIdx % arr.length) + arr.length) % arr.length;
      for (let i = 0; i < k; i++) {
        const first = arr.shift();
        arr.push(first + 12);
      }
      return arr;
    }

    function spellChordNotes(rootObj, chordDef, invIdx) {
      const letters = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
      const rootIdx = letters.indexOf(rootObj.label[0]);
      const baseLetterSteps = chordDef.family === 'triad' ? [0, 2, 4] : [0, 2, 4, 6];
      const letterSteps = baseLetterSteps.slice();
      for (let i = 0; i < invIdx; i++) {
        const f = letterSteps.shift();
        letterSteps.push(f);
      }
      const semiSteps = invertSemitoneSteps(chordDef.steps, invIdx);
      return semiSteps.map((semi, i) => ({
        note: spellNoteFromRoot(rootObj.label, letterSteps[i], semi),
        midi: rootObj.midi + semi
      }));
    }

    function buildChordsBoard() {
      stopScaleAudioSequence();
      state.roundCounter += 1;
      state.submitted = false;
      state.hasCheckedOnce = false;
      state.allSolved = false;
      state.submitAttempts = 0;
      state.sessionOver = false;
      state.chordRows = [];
      updateInlineGradeSummaryUI(0, 0, 0, false);

      const allRootCandidates = ORDERED_ALL_NOTES.slice();
      if (!state.selectedChordRootIds) {
        state.selectedChordRootIds = new Set(allRootCandidates.map(r => r.id));
      }
      let pool = allRootCandidates.filter(r => state.selectedChordRootIds.has(r.id));
      if (pool.length === 0) pool = allRootCandidates.slice();
      let chordCandidates = pool;
      if (pool.length > 1 && state.lastChordRootLabel) {
        const filtered = pool.filter(r => r.label !== state.lastChordRootLabel);
        if (filtered.length > 0) chordCandidates = filtered;
      }
      const rootObj = chordCandidates[Math.floor(Math.random() * chordCandidates.length)] || allRootCandidates[0];
      state.lastChordRootLabel = rootObj.label;
      const selectedSpecs = getSelectedChordSpecs();
      const withInv = state.chordInversionMode === 'with_inv';

      selectedSpecs.forEach((cDef, rIdx) => {
        const invCount = withInv ? cDef.invNames.length : 1;
        const chosenInv = withInv ? Math.floor(Math.random() * invCount) : 0;
        const noteItems = spellChordNotes(rootObj, cDef, chosenInv);
        const invLabel = cDef.invNames[chosenInv] || 'Root Position';
        const symFormatted = formatChordSymbolByStyle(cDef);
        const showParen = Boolean(document.getElementById('chkShowChordParenName') && document.getElementById('chkShowChordParenName').checked);
        const chordTitle = showParen ? `${rootObj.label}${symFormatted} (${cDef.name})` : `${rootObj.label}${symFormatted}`;

        const cells = noteItems.map((item, cIdx) => ({
          id: `chRow_${rIdx}_c${cIdx}`,
          answer: item.note,
          midi: item.midi,
          isRoot: false,
          isBlank: true, // เว้นไว้ทุกอันเลยให้เติมเองทั้งหมด
          userValue: '',
          gradedStatus: null
        }));

        state.chordRows.push({
          id: `chord_row_${cDef.id}_${rIdx}`,
          title: chordTitle,
          subLabel: `${cDef.family === 'triad' ? '3 โน้ต' : '4 โน้ต'} • ${invLabel}`,
          cells
        });
      });

      const all = getCurrentModuleCells();
      state.activeCellId = all.length > 0 ? all[0].id : null;

      document.getElementById('pageCleanTitle').textContent = `Chords Exercise #${state.roundCounter}`;
      document.getElementById('pageCleanSubtitle').textContent = `คอร์ดราก ${rootObj.label} • ${withInv ? 'รวมพลิกกลับ' : 'ไม่พลิกกลับ'} • เติมเองทุกช่อง`;
      document.getElementById('statusInlineHint').textContent = 'เว้นไว้ทุกช่องให้เติมเองทั้งหมด แล้วกดยืนยันคำตอบ';

      updateProgressAndSubmitUI();
      renderChordRows();
      setExerciseStartedState(false);
      startOrUpdateTimer();
    }

