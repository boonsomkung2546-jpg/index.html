      return `<text x="${cx - 32}" y="${cy + 7}" text-anchor="middle" font-size="22" font-weight="900" fill="#0f172a">${accStr}</text>`;
    }

    function buildIntervalStaffSvg(q, showLabels) {
      const yOf = (step) => 92 + (8 - step) * 10;
      const clefType = q.clef || state.currentIntervalClef || 'treble';
      const intNum = parseInt((q.answerSlots && q.answerSlots[0] && q.answerSlots[0].answer ? q.answerSlots[0].answer.slice(1) : '3'), 10) || 3;

      // Keep root & second note within at most 1-2 ledger lines of the 5-line staff (steps -2..10)
      const step1 = getBoundedRootStepForClef(q.rootNote, clefType, intNum);
      const step2 = Math.min(10, step1 + (intNum - 1));

      const parts1 = parseNoteParts(q.rootNote);
      const parts2 = parseNoteParts(q.secondNote);

      // Align both notes on the same horizontal plane (harmonic dyad like image 1); offset slightly on x only if adjacent (step diff == 1)
      const baseX = 330;
      const x1 = baseX;
      const x2 = Math.abs(step2 - step1) === 1 ? baseX + 20 : baseX;

      const renderHarmonicNoteGlyph = (cx, step, accStr, fillHex, accOffsetX = -32) => {
        const cy = yOf(step);
        let extra = '';
        for (let s = -2; s >= step; s -= 2) {
          if (s % 2 === 0) {
            extra += `<line x1="${cx - 18}" y1="${yOf(s)}" x2="${cx + 18}" y2="${yOf(s)}" stroke="#1e293b" stroke-width="2" />`;
          }
        }
        for (let s = 10; s <= step; s += 2) {
          if (s % 2 === 0) {
            extra += `<line x1="${cx - 18}" y1="${yOf(s)}" x2="${cx + 18}" y2="${yOf(s)}" stroke="#1e293b" stroke-width="2" />`;
          }
        }
        const accHtml = accStr
          ? (accStr === '𝄪'
              ? `<g transform="translate(${cx + accOffsetX - 2}, ${cy}) scale(1.45)"><path d="M -9 -9 L 0 -1.5 L 9 -9 L 10.5 -7.5 L 2 0 L 10.5 7.5 L 9 9 L 0 1.5 L -9 9 L -10.5 7.5 L -2 0 L -10.5 -7.5 Z" fill="#0f172a" /><circle cx="0" cy="-7.2" r="1.4" fill="#0f172a" /><circle cx="0" cy="7.2" r="1.4" fill="#0f172a" /><circle cx="-7.2" cy="0" r="1.4" fill="#0f172a" /><circle cx="7.2" cy="0" r="1.4" fill="#0f172a" /></g>`
              : `<text x="${cx + accOffsetX}" y="${cy + 7}" text-anchor="middle" font-size="22" font-weight="900" fill="#0f172a">${accStr}</text>`)
          : '';
        return `
          ${extra}
          ${accHtml}
          <ellipse cx="${cx}" cy="${cy}" rx="11.5" ry="8.2" transform="rotate(-14 ${cx} ${cy})" fill="${fillHex}" stroke="#0f172a" stroke-width="2" />
        `;
      };

      const staffLines = [0, 2, 4, 6, 8].map(s => {
        const y = yOf(s);
        return `<line x1="20" y1="${y}" x2="620" y2="${y}" stroke="#475569" stroke-width="1.8" />`;
      }).join('');

      const clefNameTh = clefType === 'bass' ? 'กุญแจฟา' : 'กุญแจซอล';

      return `
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-3 overflow-auto max-h-[280px]">
          <div class="flex items-center justify-between text-xs font-bold text-slate-500 px-1 mb-1">
            <span>บรรทัด 5 เส้น (${clefNameTh} • ไม่มี Key Signature • Accidental หน้าโน้ต)</span>
            ${showLabels ? `<span class="text-slate-600">โน้ตคู่: ${q.rootNote} – ${q.secondNote}</span>` : ''}
          </div>
          <svg viewBox="0 0 640 205" class="w-full min-w-[520px] max-w-[660px] mx-auto block select-none">
            ${staffLines}
            <line x1="20" y1="${yOf(8)}" x2="20" y2="${yOf(0)}" stroke="#334155" stroke-width="2" />
            <line x1="620" y1="${yOf(8)}" x2="620" y2="${yOf(0)}" stroke="#334155" stroke-width="2" />
            ${buildClefSvgMarkup(clefType, yOf)}
            ${renderHarmonicNoteGlyph(x1, step1, parts1.acc, '#93c5fd', -34)}
            ${renderHarmonicNoteGlyph(x2, step2, parts2.acc, '#fde047', -56)}
          </svg>
        </div>
      `;
    }

    function renderIntervalBoard() {
      const container = document.getElementById('intervalSingleCardContainer');
      if (!container || !Array.isArray(state.intervalItems) || state.intervalItems.length === 0) return;

      const q = state.intervalItems[0];
      const showLabels = document.getElementById('chkShowIntervalNoteLabels')
        ? Boolean(document.getElementById('chkShowIntervalNoteLabels').checked)
