      { id: 'tri_aug', family: 'triad', name: 'Augmented',  symbol: 'aug',  steps: [0, 4, 8],      invNames: ['Root Position', '1st Inversion (aug6)', '2nd Inversion (aug6/4)'] },
      // 4 โน้ต (7th Chords)
      { id: 'sev_maj7',family: 'seventh',name: 'Major 7',   symbol: 'maj7', steps: [0, 4, 7, 11],  invNames: ['Root Position', '1st Inversion (6/5)', '2nd Inversion (4/3)', '3rd Inversion (4/2)'] },
      { id: 'sev_dom7',family: 'seventh',name: '7',         symbol: '7',    steps: [0, 4, 7, 10],  invNames: ['Root Position', '1st Inversion (6/5)', '2nd Inversion (4/3)', '3rd Inversion (4/2)'] },
      { id: 'sev_min7',family: 'seventh',name: 'Minor 7',   symbol: 'm7',   steps: [0, 3, 7, 10],  invNames: ['Root Position', '1st Inversion (6/5)', '2nd Inversion (4/3)', '3rd Inversion (4/2)'] },
      { id: 'sev_mm7', family: 'seventh',name: 'Minor-Major 7',symbol: 'm(maj7)',steps: [0, 3, 7, 11],invNames: ['Root Position', '1st Inversion (6/5)', '2nd Inversion (4/3)', '3rd Inversion (4/2)'] }
    ];

    state.chordRows = [];
