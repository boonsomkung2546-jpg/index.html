          <div class="cell-given rounded-2xl p-3 border border-amber-200 flex flex-col items-center justify-center">
            <span class="text-[11px] font-bold text-slate-600">โน้ตบน</span>
            <span class="text-xl sm:text-2xl font-black mt-0.5">${q.secondNote}</span>
          </div>
        </div>
      ` : '';

      const slots = q.answerSlots || [q.answerCell];
      const answerBoxesHtml = slots.map(cell => {
        const isActive = !state.allSolved && cell.gradedStatus !== 'correct' && state.activeCellId === cell.id;
        let cls = 'cell-blank';
        let labelVal = '?';
        let hintVal = 'กดปุ่มขั้นคู่ด้านล่าง';
        if (cell.gradedStatus === 'wrong') {
          cls = 'cell-wrong';
          labelVal = cell.userValue || '?';
          hintVal = 'ผิด • เลือกใหม่ได้';
        } else if (cell.userValue) {
          cls = state.allSolved ? 'cell-correct' : 'cell-filled-draft';
          labelVal = cell.userValue;
          hintVal = state.allSolved ? 'ถูกต้อง' : 'เลือกแล้ว';
        }
        if (isActive) {
          cls += ' cell-active';
        }
        return `
          <button type="button" data-cell-id="${cell.id}" class="${cls} rounded-2xl p-3.5 flex flex-col items-center justify-center text-center">
            <span class="text-[11px] font-extrabold opacity-85">${cell.label || 'คำตอบขั้นคู่'}</span>
            <span class="text-2xl sm:text-3xl font-black mt-0.5">${labelVal}</span>
            <span class="text-[10px] font-extrabold mt-0.5">${hintVal}</span>
          </button>
        `;
      }).join('');

      container.className = 'max-w-4xl mx-auto';
      container.innerHTML = `
        <div class="border-2 border-slate-300 rounded-2xl p-5 bg-white shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
            <span class="px-3 py-1 rounded-xl bg-blue-50 text-blue-800 border border-blue-200 text-xs font-black">
              ${q.bothModes ? 'โจทย์ข้อเดียว • แบบปกติและพลิกกลับ' : (slots[0] && slots[0].label === 'พลิกกลับ' ? 'พลิกกลับ' : 'แบบปกติ')}
            </span>
            <button type="button" id="btnPlayIntervalPair" class="px-3 py-1 rounded-xl bg-emerald-100 hover:bg-emerald-200 text-emerald-900 border border-emerald-300 text-xs font-black">
              🔊 ฟังเสียงคู่นี้
            </button>
          </div>

          ${buildIntervalStaffSvg(q, showLabels)}
          ${noteInfoBoxesHtml}

          <div class="grid ${slots.length > 1 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 max-w-sm mx-auto'} gap-3">
            ${answerBoxesHtml}
          </div>
        </div>
      `;

      const noteRowsEl = document.getElementById('noteAnswerPad');
      const intPadEl = document.getElementById('intervalAnswerPad');
      const pickerTitleEl = document.getElementById('pickerHeaderTitleText');
      if (noteRowsEl) noteRowsEl.classList.add('hidden');
      if (intPadEl) intPadEl.classList.remove('hidden');
      if (pickerTitleEl) pickerTitleEl.textContent = '⠿ เลือกขั้นคู่';

      const playBtn = document.getElementById('btnPlayIntervalPair');
      if (playBtn) {
        playBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          playSingleMidi(q.rootMidi, 0.35);
          setTimeout(() => playSingleMidi(q.secondMidi, 0.42), 340);
        });
      }

      container.querySelectorAll('[data-cell-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cid = btn.getAttribute('data-cell-id');
          const cell = getCurrentModuleCells().find(c => c.id === cid);
          if (!cell || cell.gradedStatus === 'correct' || state.allSolved) return;
          state.activeCellId = cid;
          renderIntervalBoard();
        });
      });
    }

    function renderIntervalSettingsGrids() {
      const numGrid = document.getElementById('intervalNumGrid');
      if (numGrid) {
        numGrid.innerHTML = [2, 3, 4, 5, 6, 7, 8].map(n => {
          const active = state.selectedIntervalNums.has(n);
          const cls = active ? 'bg-emerald-600 text-white border-emerald-400' : 'bg-slate-950 text-slate-400 border-slate-800';
          return `<button type="button" data-intnum="${n}" class="${cls} border rounded-lg py-1 text-xs font-black">${n}</button>`;
        }).join('');
        numGrid.querySelectorAll('[data-intnum]').forEach(btn => {
          btn.addEventListener('click', () => {
            const n = parseInt(btn.getAttribute('data-intnum'), 10);
            if (state.selectedIntervalNums.has(n)) {
              if (state.selectedIntervalNums.size > 1) state.selectedIntervalNums.delete(n);
            } else {
              state.selectedIntervalNums.add(n);
            }
            renderIntervalSettingsGrids();
            if (state.activeModule === 'intervals') buildIntervalBoard();
          });
        });
      }

      const qualGrid = document.getElementById('intervalQualGrid');
      if (qualGrid) {
        const qList = [
          { code: 'A', label: 'A' },
          { code: 'M', label: 'M' },
          { code: 'P', label: 'P' },
          { code: 'm', label: 'm' },
          { code: 'd', label: 'd' }
        ];
        qualGrid.innerHTML = qList.map(q => {
          const active = state.selectedIntervalQuals.has(q.code);
          const cls = active ? 'bg-sky-600 text-white border-sky-400' : 'bg-slate-950 text-slate-400 border-slate-800';
          return `<button type="button" data-intqual="${q.code}" class="${cls} border rounded-lg py-1 text-xs font-black">${q.label}</button>`;
        }).join('');
        qualGrid.querySelectorAll('[data-intqual]').forEach(btn => {
          btn.addEventListener('click', () => {
            const q = btn.getAttribute('data-intqual');
            if (state.selectedIntervalQuals.has(q)) {
              if (state.selectedIntervalQuals.size > 1) state.selectedIntervalQuals.delete(q);
            } else {
              state.selectedIntervalQuals.add(q);
            }
            renderIntervalSettingsGrids();
            if (state.activeModule === 'intervals') buildIntervalBoard();
          });
        });
      }

      const rootGrid = document.getElementById('intervalRootGrid');
      if (rootGrid) {
        rootGrid.innerHTML = ORDERED_ALL_NOTES.map(r => {
          const active = state.selectedIntervalRootIds.has(r.id);
          const cls = active ? 'bg-amber-500 text-slate-950 border-amber-300' : 'bg-slate-950 text-slate-400 border-slate-800';
          return `<button type="button" data-introot="${r.id}" class="${cls} border rounded-lg py-1.5 px-1 text-[11px] font-black">${r.label}</button>`;
        }).join('');
        rootGrid.querySelectorAll('[data-introot]').forEach(btn => {
          btn.addEventListener('click', () => {
            const rid = btn.getAttribute('data-introot');
            if (state.selectedIntervalRootIds.has(rid)) {
              if (state.selectedIntervalRootIds.size > 1) state.selectedIntervalRootIds.delete(rid);
            } else {
              state.selectedIntervalRootIds.add(rid);
            }
            renderIntervalSettingsGrids();
            if (state.activeModule === 'intervals' && !state.useSharedNotePool) buildIntervalBoard();
          });
        });
      }
    }

    document.querySelectorAll('#intervalAnswerPad .mt-int-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const chosenInterval = btn.getAttribute('data-interval');
        if (!chosenInterval || state.allSolved || state.sessionOver || !Array.isArray(state.intervalItems) || state.intervalItems.length === 0) return;
        const allCells = getCurrentModuleCells();
        let targetCell = allCells.find(c => c.id === state.activeCellId && c.gradedStatus !== 'correct');
        if (!targetCell) {
          targetCell = allCells.find(c => !c.userValue && c.gradedStatus !== 'correct') || allCells.find(c => c.gradedStatus !== 'correct');
        }
        if (!targetCell) return;

        playSingleMidi(targetCell.midi, 0.35);
        targetCell.userValue = chosenInterval;
        if (targetCell.gradedStatus === 'wrong') targetCell.gradedStatus = null;

        const nextUnfilled = allCells.find(c => c.id !== targetCell.id && !c.userValue && c.gradedStatus !== 'correct');
        if (nextUnfilled) {
          state.activeCellId = nextUnfilled.id;
        }

        updateProgressAndSubmitUI();
        renderIntervalBoard();
        document.getElementById('statusInlineHint').textContent = 'เลือกขั้นคู่ "' + chosenInterval + '" แล้ว กดยืนยันคำตอบหรือกด Enter';
      });
    });

    const chkShowIntLabels = document.getElementById('chkShowIntervalNoteLabels');
    if (chkShowIntLabels) {
      chkShowIntLabels.addEventListener('change', () => {
        if (state.activeModule === 'intervals') renderIntervalBoard();
      });
    }

    ['chkIntClefTreble', 'chkIntClefBass'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          if (state.activeModule === 'intervals') buildIntervalBoard();
        });
      }
    });

    ['chkIntDirAsc', 'chkIntDirDesc'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          if (state.activeModule === 'intervals') buildIntervalBoard();
        });
      }
    });

    const btnIntNumsAll = document.getElementById('btnIntNumsAll');
    if (btnIntNumsAll) {
      btnIntNumsAll.addEventListener('click', () => {
        state.selectedIntervalNums = new Set([2, 3, 4, 5, 6, 7, 8]);
        renderIntervalSettingsGrids();
        if (state.activeModule === 'intervals') buildIntervalBoard();
      });
    }

    const btnIntQualsAll = document.getElementById('btnIntQualsAll');
    if (btnIntQualsAll) {
      btnIntQualsAll.addEventListener('click', () => {
        state.selectedIntervalQuals = new Set(['A', 'M', 'P', 'm', 'd']);
        renderIntervalSettingsGrids();
        if (state.activeModule === 'intervals') buildIntervalBoard();
      });
    }

    const btnIntRootsAll = document.getElementById('btnIntRootsAll');
    if (btnIntRootsAll) {
      btnIntRootsAll.addEventListener('click', () => {
        state.selectedIntervalRootIds = new Set(ORDERED_ALL_NOTES.map(r => r.id));
        renderIntervalSettingsGrids();
        if (state.activeModule === 'intervals' && !state.useSharedNotePool) buildIntervalBoard();
      });
    }

    const btnEnterInt = document.getElementById('btnEnterIntervalMode');
    if (btnEnterInt) {
      btnEnterInt.addEventListener('click', () => {
        switchModule('intervals');
        closeSideDrawer();
      });
    }

    renderIntervalSettingsGrids();

    renderSharedNotePoolGrid();
    renderMtKeySignaturesPicker();
    switchModule('sharps_flats');
  </script>
</body>
</html>
