    function spellNoteFromRoot(rootLabel, letterStep, targetSemi) {
      const letters = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
      const basePcs = { C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 };
      const rootLetter = rootLabel[0];
      const rootIdx = letters.indexOf(rootLetter);
      const targetLetter = letters[(((rootIdx + letterStep) % 7) + 7) % 7];

      const rootMidi = NOTE_MIDI_MAP[rootLabel] || 60;
      const expectedMidi = rootMidi + targetSemi;
      const expectedPc = ((expectedMidi % 12) + 12) % 12;
      const natPc = basePcs[targetLetter];

      let diff = (expectedPc - natPc + 12) % 12;
      if (diff > 6) diff -= 12;

      if (diff === 0) return targetLetter;
      if (diff === 1) return `${targetLetter}♯`;
      if (diff === 2) return `${targetLetter}𝄪`;
      if (diff === -1) return `${targetLetter}♭`;
      if (diff === -2) return `${targetLetter}♭♭`;
      return targetLetter;
    }

    function buildScaleSequenceWithMidis(rootObj, formulaObj, directionMode, melodicDescMode) {
      if (directionMode === 'asc') {
        return formulaObj.ascSemi.map((semi, idx) => ({
          note: spellNoteFromRoot(rootObj.label, idx, semi),
          midi: rootObj.midi + semi
        }));
      }

      const octaveSemi = formulaObj.ascSemi[0] + 12;
      const ascWithTurnSemi = [...formulaObj.ascSemi, octaveSemi];
      const ascItems = ascWithTurnSemi.map((semi, idx) => ({
        note: spellNoteFromRoot(rootObj.label, idx, semi),
        midi: rootObj.midi + semi
      }));

      const descLetterSteps = [6, 5, 4, 3, 2, 1, 0];
      const descSemiArr = (formulaObj.id === 'melodic' && melodicDescMode === 'jazz')
        ? formulaObj.descSemiJazz
        : formulaObj.descSemiNatural;

      const descItems = descSemiArr.map((semi, idx) => ({
        note: spellNoteFromRoot(rootObj.label, descLetterSteps[idx], semi),
        midi: rootObj.midi + semi
      }));
      return [...ascItems, ...descItems];
    }

