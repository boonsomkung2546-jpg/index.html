    function makeElementDraggable(el, handleEl) {
      let dragging = false, sx = 0, sy = 0, ol = 0, ot = 0;
      handleEl.addEventListener('mousedown', (e) => {
        if (e.target.closest('button')) return;
        dragging = true;
        const rect = el.getBoundingClientRect();
        ol = rect.left;
        ot = rect.top;
        sx = e.clientX;
        sy = e.clientY;
        el.style.transform = el.id === 'floatingNotePicker' ? `scale(${state.pickerScale})` : 'none';
        el.style.right = 'auto';
        el.style.bottom = 'auto';
        el.style.left = `${ol}px`;
        el.style.top = `${ot}px`;
      });
      window.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        el.style.left = `${ol + (e.clientX - sx)}px`;
        el.style.top = `${ot + (e.clientY - sy)}px`;
      });
      window.addEventListener('mouseup', () => { dragging = false; });
    }

