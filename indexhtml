    function buildAccidentalSvgMarkup(accStr, cx, cy) {
      if (!accStr) return '';
      if (accStr === '𝄪') {
        return `
          <g transform="translate(${cx - 32}, ${cy}) scale(1.28)">
            <path d="M -8 -8 L 0 -2 L 8 -8 L 6 0 L 8 8 L 0 2 L -8 8 L -6 0 Z" fill="#0f172a" stroke="#0f172a" stroke-width="0.6" stroke-linejoin="round" />
