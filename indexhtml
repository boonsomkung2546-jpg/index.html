        activeDefs.push({ kind: 'flats', title: 'FLAT KEY SIGNATURES', badge: '7 แฟลต (♭)', raw: FLAT_ROWS_DATA });
      }

      activeDefs.forEach(def => {
        const rows = def.raw.map((r, rIdx) => {
          const nLen = r.notes.length;
          const blankCountInRow = Math.max(1, Math.min(nLen, Math.round((state.sfMissingPct / 100) * nLen)));
          const idxs = Array.from({ length: nLen }, (_, k) => k);
          for (let i = idxs.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [idxs[i], idxs[j]] = [idxs[j], idxs[i]];
          }
          const blankSet = new Set(idxs.slice(0, blankCountInRow));

          const cells = r.notes.map((noteStr, cIdx) => ({
            id: `sf_${def.kind}_r${rIdx}_c${cIdx}`,
            answer: noteStr,
            midi: NOTE_MIDI_MAP[noteStr] || 60,
            isHi: r.hiSet.has(cIdx),
            isBlank: blankSet.has(cIdx),
            userValue: '',
            gradedStatus: null
          }));

          return { countLabel: r.countLabel, cells };
        });

        state.sfTables.push({ id: def.kind, kind: def.kind, title: def.title, badge: def.badge, rows });
      });

      const all = getCurrentModuleCells();
      const firstBlank = all.find(c => c.isBlank);
      state.activeCellId = firstBlank ? firstBlank.id : null;

      const modeText = state.sfGridMode === 'sharps' ? 'ทางชาร์ป (0–7♯)' : (state.sfGridMode === 'flats' ? 'ทางแฟลต (0–7♭)' : 'ทั้ง 7♯ และ 7♭');
