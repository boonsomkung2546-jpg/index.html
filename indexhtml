// ระบบแบบฝึกหัดขั้นคู่ (Intervals: 2-8, ขาขึ้น/ขาลง, เลือกชนิดขั้นคู่และโน้ตตั้งต้น)
    const INTERVAL_BASE_SEMI = { 2: 2, 3: 4, 4: 5, 5: 7, 6: 9, 7: 11, 8: 12 };
    const INTERVAL_QUAL_OFFSET = {
      'A': 1,
      'M': 0,
      'P': 0,
      'm': -1,
      'd': -1
    };

    function getValidIntervalCodes() {
      const valid = [];
      const nums = [2, 3, 4, 5, 6, 7, 8];
      const qualsByNum = {
        2: ['A2', 'M2', 'm2', 'd2'],
        3: ['A3', 'M3', 'm3', 'd3'],
        4: ['A4', 'P4', 'd4'],
        5: ['A5', 'P5', 'd5'],
        6: ['A6', 'M6', 'm6', 'd6'],
        7: ['A7', 'M7', 'm7', 'd7'],
        8: ['A8', 'P8', 'd8']
      };
      nums.forEach(n => {
        if (!state.selectedIntervalNums.has(n)) return;
        (qualsByNum[n] || []).forEach(code => {
          const q = code[0];
          if (state.selectedIntervalQuals.has(q)) {
            valid.push(code);
          }
        });
      });
      return valid.length > 0 ? valid : ['M3', 'P5'];
    }

    function computeSecondNoteForInterval(rootObj, code, dir) {
      const num = parseInt(code.slice(1), 10) || 3;
      const qual = code[0] || 'M';
      const base = INTERVAL_BASE_SEMI[num] || 4;
      let delta = base;
      if (qual === 'A') delta = base + 1;
      else if (qual === 'm') delta = base - 1;
      else if (qual === 'd') {
        delta = ['P4', 'P5', 'P8'].includes(`${qual}${num}`) ? base - 1 : base - 2;
      }

      if (dir === 'desc') {
        const targetMidi = rootObj.midi - delta;
        const letterStep = -(num - 1);
        const noteStr = spellNoteFromRoot(rootObj.label, letterStep, -delta);
        return { note: noteStr, midi: targetMidi };
      } else {
        const targetMidi = rootObj.midi + delta;
        const letterStep = num - 1;
        const noteStr = spellNoteFromRoot(rootObj.label, letterStep, delta);
        return { note: noteStr, midi: targetMidi };
      }
    }

    state.selectedIntervalNums = new Set([2, 3, 4, 5, 6, 7, 8]);
    state.selectedIntervalQuals = new Set(['A', 'M', 'P', 'm', 'd']);
    state.selectedIntervalRootIds = new Set(ORDERED_ALL_NOTES.map(r => r.id));
    state.intervalQuestion = null;

    state.intervalItems = [];
    state.showIntervalNoteLabels = true;
    state.currentIntervalClef = 'treble';

    function invertIntervalCodeLabel(code) {
      if (!code || code.length < 2) return 'm6';
      const qual = code[0];
      const num = parseInt(code.slice(1), 10) || 3;
      const invNum = 9 - num;
      let invQual = qual;
      if (qual === 'M') invQual = 'm';
      else if (qual === 'm') invQual = 'M';
      else if (qual === 'A') invQual = 'd';
      else if (qual === 'd') invQual = 'A';
      else if (qual === 'P') invQual = 'P';
      return `${invQual}${invNum}`;
    }

    function pickActiveIntervalClef() {
      const useTreble = !document.getElementById('chkIntClefTreble') || document.getElementById('chkIntClefTreble').checked;
      const useBass = !document.getElementById('chkIntClefBass') || document.getElementById('chkIntClefBass').checked;
      const pool = [];
      if (useTreble) pool.push('treble');
      if (useBass) pool.push('bass');
      if (pool.length === 0) return 'treble';
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function getBoundedRootStepForClef(rootLabel, clefType, intervalNum) {
      // Keep root note comfortably inside or within at most 1-2 ledger lines of the 5-line staff (lines 0..8)
      const diatonicOrder = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
      const parts = parseNoteParts(rootLabel);
      const lIdx = diatonicOrder.indexOf(parts.letter);
      // Candidate steps in treble or bass around the middle of the staff
      // Treble middle: steps 2..6 (G4..D5); Bass middle: steps 2..6 (B2..F3)
      const candidates = [-2, 0, 1, 2, 3, 4, 5, 6].map(base => {
        // Adjust to match letter name
        const diff = (lIdx - ((base + 2 + 7) % 7) + 7) % 7;
        return base + (diff > 3 ? diff - 7 : diff);
      });
      const maxTopStep = Math.min(10, 10 - Math.max(0, (intervalNum - 1) - 4));
      const fitting = candidates.filter(st => st >= -2 && st <= maxTopStep);
      if (fitting.length > 0) {
        return fitting[Math.floor(fitting.length / 2)];
      }
      return 2;
    }

    function buildIntervalBoard() {
      stopScaleAudioSequence();
      state.roundCounter += 1;
      state.submitted = false;
      state.hasCheckedOnce = false;
      state.allSolved = false;
      state.submitAttempts = 0;
      state.sessionOver = false;
      updateInlineGradeSummaryUI(0, 0, 0, false);

      let rootPool = [];
      if (state.useSharedNotePool && state.sharedSelectedKeyIds && state.sharedSelectedKeyIds.size > 0) {
        rootPool = SHARED_ROOT_POOL.filter(r => state.sharedSelectedKeyIds.has(r.id));
      } else {
        rootPool = ORDERED_ALL_NOTES.filter(r => state.selectedIntervalRootIds.has(r.id));
      }
      if (!rootPool || rootPool.length === 0) rootPool = ORDERED_ALL_NOTES.slice();
      const allowAsc = !document.getElementById('chkIntDirAsc') || document.getElementById('chkIntDirAsc').checked;
      const allowDesc = !document.getElementById('chkIntDirDesc') || document.getElementById('chkIntDirDesc').checked;
      const bothModes = allowAsc && allowDesc;
      const validCodes = getValidIntervalCodes();

      const useTreble = !document.getElementById('chkIntClefTreble') || document.getElementById('chkIntClefTreble').checked;
      const useBass = !document.getElementById('chkIntClefBass') || document.getElementById('chkIntClefBass').checked;
      const clefPool = [];
      if (useTreble) clefPool.push('treble');
      if (useBass) clefPool.push('bass');
      if (clefPool.length === 0) clefPool.push('treble');

      const totalDistinctApprox = rootPool.length * clefPool.length * validCodes.length;
      let rootObj = rootPool[Math.floor(Math.random() * rootPool.length)] || ORDERED_ALL_NOTES[0];
      let chosenClef = clefPool[Math.floor(Math.random() * clefPool.length)];
      let primaryCode = validCodes[Math.floor(Math.random() * validCodes.length)];

      if (totalDistinctApprox > 1 && state.lastIntervalQuestionSig) {
        for (let attempt = 0; attempt < 25; attempt++) {
          const candRoot = rootPool[Math.floor(Math.random() * rootPool.length)] || ORDERED_ALL_NOTES[0];
          const candClef = clefPool[Math.floor(Math.random() * clefPool.length)];
          const candCode = validCodes[Math.floor(Math.random() * validCodes.length)];
          const sig = `${candRoot.label}|${candClef}|${bothModes ? 'both' : (allowDesc ? 'desc' : 'asc')}|${candCode}`;
          if (sig !== state.lastIntervalQuestionSig) {
            rootObj = candRoot;
            chosenClef = candClef;
            primaryCode = candCode;
            break;
          }
        }
      }
      state.lastIntervalQuestionSig = `${rootObj.label}|${chosenClef}|${bothModes ? 'both' : (allowDesc ? 'desc' : 'asc')}|${primaryCode}`;
      state.currentIntervalClef = chosenClef;
      const secondInfo = computeSecondNoteForInterval(rootObj, primaryCode, 'asc');

      const slots = [];
      if (bothModes) {
        const invCode = invertIntervalCodeLabel(primaryCode);
        slots.push({
          id: 'int_ans_0',
          label: 'แบบปกติ',
          answer: primaryCode,
          midi: secondInfo.midi,
          isBlank: true,
          userValue: '',
          gradedStatus: null
        });
        slots.push({
          id: 'int_ans_1',
          label: 'พลิกกลับ',
          answer: invCode,
          midi: secondInfo.midi,
          isBlank: true,
          userValue: '',
          gradedStatus: null
        });
      } else {
        slots.push({
          id: 'int_ans_0',
          label: allowDesc ? 'พลิกกลับ' : 'แบบปกติ',
          answer: allowDesc ? invertIntervalCodeLabel(primaryCode) : primaryCode,
          midi: secondInfo.midi,
          isBlank: true,
          userValue: '',
          gradedStatus: null
        });
      }

      state.intervalItems = [{
        id: 'int_single_q_0',
        rootNote: rootObj.label,
        rootMidi: rootObj.midi,
        secondNote: secondInfo.note,
        secondMidi: secondInfo.midi,
        dir: allowDesc && !allowAsc ? 'desc' : 'asc',
        clef: chosenClef,
        bothModes: bothModes,
        answerSlots: slots,
        answerCell: slots[0]
      }];

      state.intervalQuestion = state.intervalItems[0];
      state.activeCellId = slots[0].id;

      const clefLabel = chosenClef === 'bass' ? 'กุญแจฟา' : 'กุญแจซอล';
      const modeDesc = bothModes ? 'โจทย์ข้อเดียว • แบบปกติและพลิกกลับ' : (allowDesc ? 'พลิกกลับ' : 'แบบปกติ');
      document.getElementById('pageCleanTitle').textContent = `Intervals Exercise #${state.roundCounter}`;
      document.getElementById('pageCleanSubtitle').textContent = `${clefLabel} • ${modeDesc}`;
      document.getElementById('statusInlineHint').textContent = 'เลือกขั้นคู่จากแผงด้านล่าง แล้วกดยืนยันคำตอบ';

      updateProgressAndSubmitUI();
      renderIntervalBoard();
      setExerciseStartedState(false);
      startOrUpdateTimer();
    }

    const __origGetCurrentCellsAll = getCurrentModuleCells;
    getCurrentModuleCells = function() {
      if (state.activeModule === 'intervals') {
