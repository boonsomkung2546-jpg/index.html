    function parseNoteParts(noteLabel) {
      const m = String(noteLabel || 'C').match(/^([A-G])(.*)$/);
      return {
        letter: m ? m[1] : 'C',
        acc: m ? m[2] : ''
      };
    }

    function buildClefSvgMarkup(clefType, yOf) {
      if (clefType === 'bass') {
        const fLineY = yOf(6);
        return `
          <g transform="translate(52, 0)">
            <path d="M -8 ${fLineY + 12} C 6 ${fLineY + 6}, 14 ${fLineY - 8}, 12 ${fLineY - 22} C 10 ${fLineY - 34}, -4 ${fLineY - 36}, -11 ${fLineY - 25} C -15 ${fLineY - 19}, -7 ${fLineY - 12}, -3 ${fLineY - 17} C 0 ${fLineY - 21}, -4 ${fLineY - 27}, -8 ${fLineY - 24}"
