          if (btnEl) btnEl.classList.add('cell-playing-note');
          playSingleMidi(cell.midi, 0.32);
        }, (delayOffsetSec * 1000) + idx * stepMs);
        state.playbackTimers.push(tId);
      });
      const endTimer = setTimeout(() => {
        document.querySelectorAll('.cell-playing-note').forEach(el => el.classList.remove('cell-playing-note'));
      }, (delayOffsetSec * 1000) + row.cells.length * stepMs + 150);
      state.playbackTimers.push(endTimer);
      return (row.cells.length * stepMs) / 1000;
    }

    function formatClock(secTotal) {
      const s = Math.max(0, Math.floor(secTotal));
      const mins = Math.floor(s / 60);
      const secs = s % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function formatThaiDuration(secTotal) {
      const s = Math.max(0, Math.floor(secTotal));
