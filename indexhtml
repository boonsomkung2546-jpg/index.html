    function startOrUpdateTimer() {
      if (!state.exerciseStarted) {
        updateSessionBadgeUI();
        return;
      }
      const activeTimerMode = state.minorTimerMode;
      if (activeTimerMode === 'countdown') {
        document.getElementById('timerLabelPrefix').textContent = 'เวลาท้าทาย:';
        if (!state.countdownEndTimeMs && !state.sessionOver) {
          state.countdownEndTimeMs = performance.now() + (state.countdownLimitSec * 1000);
        }
        if (state.countdownEndTimeMs && !state.sessionOver) {
          const remNowSec = Math.max(0, (state.countdownEndTimeMs - performance.now()) / 1000);
          document.getElementById('timerDisplay').textContent = formatClock(remNowSec);
        }
        if (!state.timerInterval && !state.sessionOver) {
          state.timerInterval = setInterval(() => {
            if (state.sessionOver) { stopTimer(); return; }
            const remSec = Math.max(0, ((state.countdownEndTimeMs || performance.now()) - performance.now()) / 1000);
            document.getElementById('timerDisplay').textContent = formatClock(remSec);
            if (remSec <= 0) {
              stopTimer();
              handleCountdownTimeUp();
            }
          }, 250);
        }
      } else if (activeTimerMode === 'fixed_count') {
        document.getElementById('timerLabelPrefix').textContent = 'เวลารวม:';
        if (!state.fixedStartTimeMs && !state.sessionOver) {
          state.fixedStartTimeMs = performance.now();
        }
        if (state.fixedStartTimeMs && !state.sessionOver) {
          const curElapsed = (performance.now() - state.fixedStartTimeMs) / 1000;
          document.getElementById('timerDisplay').textContent = formatClock(curElapsed);
        }
        if (!state.timerInterval && !state.sessionOver) {
          state.timerInterval = setInterval(() => {
            if (state.sessionOver) { stopTimer(); return; }
            const elapsedSec = ((performance.now() - (state.fixedStartTimeMs || performance.now())) / 1000);
            document.getElementById('timerDisplay').textContent = formatClock(elapsedSec);
          }, 250);
        }
      } else {
        // โหมดปกติ (1): ไม่มีการจับเวลา
        stopTimer();
        document.getElementById('timerLabelPrefix').textContent = 'จับเวลา:';
        document.getElementById('timerDisplay').textContent = 'ปิดอยู่';
