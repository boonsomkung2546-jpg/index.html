          if (state.selectedScaleNoteLabels.has(lbl)) {
            if (state.selectedScaleNoteLabels.size > 1) state.selectedScaleNoteLabels.delete(lbl);
          } else {
            state.selectedScaleNoteLabels.add(lbl);
          }
          renderMtKeySignaturesPicker();
          resetMinorSessionAndStart();
        });
      });
    }

    document.querySelectorAll('.scfamily-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const chosenFam = btn.getAttribute('data-scfamily');
        state.scaleFamily = chosenFam === 'major' ? 'major' : 'minor';
        document.querySelectorAll('.scfamily-btn').forEach(b => {
          const active = b.getAttribute('data-scfamily') === state.scaleFamily;
          b.className = active
            ? 'scfamily-btn py-2 px-2.5 rounded-lg font-extrabold bg-blue-600 text-white text-center'
            : 'scfamily-btn py-2 px-2.5 rounded-lg font-bold text-slate-300 hover:text-white text-center';
        });
        const minorBox = document.getElementById('minorSubSettingsBox');
        if (minorBox) minorBox.classList.toggle('hidden', state.scaleFamily !== 'minor');
        sideDrawerTitle.textContent = state.scaleFamily === 'major' ? 'ตั้งค่าสเกลเมเจอร์ (Major)' : 'ตั้งค่าสเกลไมเนอร์ (Minor)';
        if (state.activeModule !== 'minor_scales') {
          switchModule('minor_scales');
        } else {
          resetMinorSessionAndStart();
        }
      });
    });

    function startExerciseNow() {
      if (state.exerciseStarted) return;
      if (typeof closeSideDrawer === 'function') {
        closeSideDrawer();
      }
      setExerciseStartedState(true);
      if (state.activeModule === 'minor_scales' && typeof window.__syncScaleHeaderHints === 'function') {
        window.__syncScaleHeaderHints();
      }
      startOrUpdateTimer();
    }

    document.getElementById('btnStartExerciseGate').addEventListener('click', startExerciseNow);

    document.getElementById('btnEnterSFMode').addEventListener('click', () => {
      switchModule('sharps_flats');
      closeSideDrawer();
    });

    document.getElementById('btnEnterScaleMode').addEventListener('click', () => {
      switchModule('minor_scales');
      closeSideDrawer();
    });

    function generateNewMinorRound(isFreshSession = false) {
      stopScaleAudioSequence();
            if (state.sessionOver && !isFreshSession) {
        resetMinorSessionAndStart();
        return;
      }

      state.roundCounter += 1;
      const selectedTypes = state.scaleFamily === 'major'
        ? [MAJOR_SCALE_FORMULA]
        : getSelectedMinorTypes();
      if (!state.selectedScaleNoteLabels || state.selectedScaleNoteLabels.size === 0) {
        state.selectedScaleNoteLabels = new Set(['A', 'C', 'D', 'E', 'F', 'G', 'B']);
      }
      let pool = ORDERED_ALL_NOTES.filter(k => state.selectedScaleNoteLabels.has(k.label) && k.label !== 'D♯');
      if (pool.length === 0) pool = ORDERED_ALL_NOTES.filter(k => k.label !== 'D♯');

      let candidates = pool;
      if (state.currentRoot && candidates.length > 1) {
        candidates = candidates.filter(r => r.label !== state.currentRoot.label);
      }
      const rootObj = candidates[Math.floor(Math.random() * candidates.length)] || ORDERED_ALL_NOTES[0];
      state.currentRoot = rootObj;
      state.submitted = false;
      state.hasCheckedOnce = false;
      state.allSolved = false;
      state.submitAttempts = 0;
      state.minorRows = [];
      updateInlineGradeSummaryUI(0, 0, 0, false);

      const dirLabel = state.minorDirection === 'asc' ? 'ขาไปอย่างเดียว (↑)' : 'ขาไปกลับ (↑↓)';
      const famTitle = state.scaleFamily === 'major' ? 'Major Scale' : 'Minor Scale';
      const typeNamesOnly = selectedTypes.map(t => t.title).join(' • ');

      function syncScaleHeaderHints() {
        document.getElementById('pageCleanTitle').textContent = `${famTitle} Exercise #${state.roundCounter}`;
        document.getElementById('pageCleanSubtitle').textContent = `${typeNamesOnly} • ${dirLabel}`;
        if (!state.exerciseStarted) {
          document.getElementById('statusInlineHint').textContent = 'กดปุ่ม "▶ กดเริ่มแบบฝึกหัด" หรือกด R / Enter เพื่อเริ่มทำ';
        } else {
          document.getElementById('statusInlineHint').textContent = 'เติมโน้ตให้ครบทุกช่อง แล้วกดยืนยันคำตอบ';
        }
      }
      window.__syncScaleHeaderHints = syncScaleHeaderHints;
      syncScaleHeaderHints();

      const useL3 = !document.getElementById('chkScaleLayer3') || document.getElementById('chkScaleLayer3').checked;
      const useL4 = !document.getElementById('chkScaleLayer4') || document.getElementById('chkScaleLayer4').checked;
      const useTension = !document.getElementById('chkScaleLayerTension') || document.getElementById('chkScaleLayerTension').checked;
      const activeLayers = (useL3 || useL4 || useTension)
        ? { l3: useL3, l4: useL4, tension: useTension }
        : { l3: true, l4: false, tension: false };

      selectedTypes.forEach((fObj, rIdx) => {
        const seqItems = buildScaleSequenceWithMidis(rootObj, fObj, state.minorDirection, state.melodicDescMode);
        const cells = seqItems.map((item, cIdx) => {
          const degInOct = (cIdx % 7) + 1; // 1..7 (and octave 8/1)
          const isTriadNote = [1, 3, 5].includes(degInOct);
          const isSeventhNote = degInOct === 7;
          const isTensionNote = [2, 4, 6].includes(degInOct);
          const shouldBeBlank = (activeLayers.l3 && isTriadNote)
            || (activeLayers.l4 && isSeventhNote)
            || (activeLayers.tension && isTensionNote);

          return {
            id: `mRow_${rIdx}_c${cIdx}`,
            answer: item.note,
            midi: item.midi,
            isRoot: !shouldBeBlank && cIdx === 0,
            isBlank: shouldBeBlank,
            userValue: '',
            gradedStatus: null
          };
        });

        state.minorRows.push({
          id: `row_${fObj.id}`,
          typeId: fObj.id,
          title: `${rootObj.label} ${fObj.title}`,
          formulaDesc: fObj.formulaDesc,
          cells
        });
      });

      const all = getCurrentModuleCells();
      const firstBlank = all.find(c => c.isBlank);
      state.activeCellId = firstBlank ? firstBlank.id : null;

      updateProgressAndSubmitUI();
      renderMinorRows();
      setExerciseStartedState(false);
      startOrUpdateTimer();
    }

    function renderMinorRows() {
      const container = document.getElementById('minorRowsContainer');
      const colsCount = state.minorDirection === 'both' ? 15 : 7;
      const showFormula = document.getElementById('chkShowFormulaHint').checked;

      container.innerHTML = state.minorRows.map(row => `
        <div class="space-y-1">
          <div class="grid grid-cols-[205px_repeat(${colsCount},minmax(0,1fr))] border border-slate-300 rounded-xl overflow-hidden divide-x divide-slate-300 shadow-sm">
            <div class="row-num-cell px-2.5 py-2.5 flex items-center justify-between gap-1.5">
              <div>
                <div class="text-xs sm:text-sm font-black leading-tight">${row.title}</div>
                <div class="text-[10px] font-bold text-slate-400">${state.minorDirection === 'asc' ? 'ขาไป (1→7)' : 'ขาไปกลับ (1→8→1)'}</div>
              </div>
              <button type="button" data-play-row="${row.id}" class="px-2 py-1 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-[11px] font-black border border-emerald-300 shrink-0" title="ฟังเสียงสเกลแถวนี้">
                🔊
              </button>
            </div>
            ${row.cells.map((cell, cIdx) => {
              const isLockedCorrect = cell.gradedStatus === 'correct';
              const isActive = !state.allSolved && !isLockedCorrect && state.activeCellId === cell.id;
              const isTurn8 = state.minorDirection === 'both' && cIdx === 7;
              let cls = 'cell-root';
              let mainText = cell.answer;
              let subHint = isTurn8 ? 'จุดกลับ 8' : '';

              if (cell.isBlank) {
                if (false) {
                  cls = 'cell-correct';
                  mainText = cell.answer;
                  subHint = cell.userValue && cell.userValue !== cell.answer ? `ตอบ: ${cell.userValue}` : 'เฉลยครู';
                } else if (cell.gradedStatus === 'wrong') {
                  cls = 'cell-wrong cursor-pointer';
                  mainText = cell.userValue || '?';
                  subHint = isTurn8 ? 'จุดกลับ 8 • ผิด' : 'ผิด • แก้ได้';
                } else if (cell.userValue) {
                  cls = state.allSolved ? 'cell-correct' : 'cell-filled-draft';
                  mainText = cell.userValue;
                  if (isTurn8 && !state.allSolved) subHint = 'จุดกลับ 8';
                } else {
                  cls = 'cell-blank';
                  mainText = '?';
                }
                if (isActive) {
                  cls += ' cell-active';
                }
              }

              if (isTurn8) {
                cls += ' ring-2 ring-amber-400 border-amber-500';
              }

              return `
                <button type="button" data-cell-id="${cell.id}" class="${cls} py-3 px-1 flex flex-col items-center justify-center text-sm sm:text-base font-extrabold">
                  <span>${mainText}</span>
                  ${subHint ? `<span class="text-[9px] font-black leading-none mt-0.5 ${isTurn8 ? 'text-amber-700' : ''}">${subHint}</span>` : ''}
                </button>
              `;
            }).join('')}
          </div>
          ${showFormula ? `<div class="text-[11px] font-bold text-indigo-700 px-2">💡 ${row.title}: ${row.formulaDesc}</div>` : ''}
        </div>
      `).join('');

      container.querySelectorAll('[data-play-row]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          stopScaleAudioSequence();
          playScaleRowSequence(btn.getAttribute('data-play-row'), 0);
        });
      });

      container.querySelectorAll('[data-cell-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cid = btn.getAttribute('data-cell-id');
          const cell = getCurrentModuleCells().find(c => c.id === cid);
          if (!cell) return;
          if (!cell.isBlank || cell.gradedStatus === 'correct' || state.allSolved) {
            playSingleMidi(cell.midi, 0.36);
            return;
          }
          state.activeCellId = cid;
          renderMinorRows();
        });
      });
    }

    function handleCountdownTimeUp() {
      state.sessionOver = true;
      state.allSolved = true;
      renderActiveBoard();
      updateProgressAndSubmitUI();
      updateInlineGradeSummaryUI(state.sessionCompletedCount, 0, state.sessionCompletedCount, true);
      const summaryMsg = `⏳ หมดเวลา ${formatThaiDuration(state.countdownLimitSec)}! ทำสำเร็จทั้งหมด ${state.sessionCompletedCount} ข้อ (ถูกสมบูรณ์ ${state.sessionPerfectCount} ข้อ)`;
      document.getElementById('statusInlineHint').textContent = summaryMsg;

      const modalEl = document.getElementById('countdownResultModal');
      const titleEl = modalEl ? modalEl.querySelector('h2') : null;
      if (titleEl) titleEl.textContent = 'หมดเวลาแล้ว!';
      const compEl = document.getElementById('cdResultCompletedNum');
      const perfEl = document.getElementById('cdResultPerfectNum');
      const timeEl = document.getElementById('cdResultTimeText');
      if (compEl) compEl.textContent = `${state.sessionCompletedCount} ข้อ`;
      if (perfEl) perfEl.textContent = `${state.sessionPerfectCount} ข้อ`;
      if (timeEl) timeEl.textContent = `จับเวลาครบ ${formatThaiDuration(state.countdownLimitSec)}`;
      if (modalEl) modalEl.classList.remove('hidden');
    }

    function handleNotePress(chosenNote) {
      playNoteNameAudio(chosenNote);
      if (state.allSolved || state.sessionOver) return;

      const all = getCurrentModuleCells();
      let target = all.find(c => c.id === state.activeCellId && c.isBlank && c.gradedStatus !== 'correct');
      if (!target) {
        target = all.find(c => c.isBlank && c.gradedStatus !== 'correct' && (!c.userValue || c.gradedStatus === 'wrong'))
              || all.find(c => c.isBlank && c.gradedStatus !== 'correct');
      }
      if (!target) return;

      target.userValue = chosenNote;
      if (target.gradedStatus === 'wrong') {
        target.gradedStatus = null;
      }

      const editableBlanks = all.filter(c => c.isBlank && c.gradedStatus !== 'correct');
      const curIdx = editableBlanks.findIndex(c => c.id === target.id);
      let nextCell = null;
      for (let offset = 1; offset <= editableBlanks.length; offset++) {
        const cand = editableBlanks[(curIdx + offset) % editableBlanks.length];
        if (!cand.userValue || cand.gradedStatus === null) {
          nextCell = cand;
          break;
        }
      }
      state.activeCellId = nextCell ? nextCell.id : target.id;

      updateProgressAndSubmitUI();
      renderActiveBoard();

      const blanks = all.filter(c => c.isBlank);
      const filledCount = blanks.filter(c => Boolean(c.userValue)).length;
      if (filledCount === blanks.length) {
        document.getElementById('statusInlineHint').textContent = state.hasCheckedOnce
          ? 'แก้ไขครบแล้ว! กดปุ่ม "✓ ตรวจคำตอบที่แก้" เพื่อตรวจอีกครั้ง'
          : 'เติมครบทุกช่องแล้ว! กดปุ่ม "✓ ยืนยันคำตอบ" เพื่อตรวจผล';
      } else {
        document.getElementById('statusInlineHint').textContent = `เติมแล้ว ${filledCount}/${blanks.length} ช่อง (ยังไม่เฉลยจนกว่าจะกดยืนยัน)`;
      }
    }

    function clearSelectedDraftCell() {
      if (state.allSolved || state.sessionOver) return;
      const target = getCurrentModuleCells().find(c => c.id === state.activeCellId && c.isBlank && c.gradedStatus !== 'correct');
      if (!target) return;
      target.userValue = '';
      target.gradedStatus = null;
      updateProgressAndSubmitUI();
      renderActiveBoard();
    }

    function submitAllAnswers() {
      if (state.allSolved || state.sessionOver) return;
      const all = getCurrentModuleCells();
      const blanks = all.filter(c => c.isBlank);
      if (blanks.length === 0 || blanks.some(c => !c.userValue)) return;

      state.hasCheckedOnce = true;
      state.submitAttempts += 1;

      let correctCnt = 0;
      let wrongCnt = 0;
      blanks.forEach(cell => {
        if (cell.userValue === cell.answer) {
          cell.gradedStatus = 'correct';
          correctCnt += 1;
        } else {
          cell.gradedStatus = 'wrong';
          wrongCnt += 1;
        }
      });

      const isPerfect = wrongCnt === 0;
      state.allSolved = isPerfect;

      if (!isPerfect) {
        const firstWrong = blanks.find(c => c.gradedStatus === 'wrong');
        state.activeCellId = firstWrong ? firstWrong.id : null;
      } else {
        state.activeCellId = null;
      }

      updateProgressAndSubmitUI();
      updateInlineGradeSummaryUI(correctCnt, wrongCnt, blanks.length, isPerfect);
      renderActiveBoard();

      if (!isPerfect) {
        const wrongList = collectWrongLabelsList();
        const previewWrong = wrongList.slice(0, 6).join(', ') + (wrongList.length > 6 ? ` และอีก ${wrongList.length - 6} ช่อง` : '');
        document.getElementById('statusInlineHint').textContent =
          `ส่งครั้งที่ ${state.submitAttempts}: ถูก ${correctCnt}/${blanks.length} • ผิด ${wrongCnt} ช่อง → ผิดที่: ${previewWrong} (คลิกแก้ช่องแดงแล้วกดส่งใหม่ได้)`;
        return;
      }

      state.sessionCompletedCount += 1;
      state.sessionPerfectCount += 1;
      updateSessionBadgeUI();

      if (state.minorTimerMode === 'stopwatch') {
        document.getElementById('statusInlineHint').textContent =
          `🎉 ถูกต้องครบทั้ง ${blanks.length} ช่อง! (ส่ง ${state.submitAttempts} ครั้ง) กำลังไปข้อถัดไป...`;
        setTimeout(() => {
          if (state.minorTimerMode === 'stopwatch') {
            generateRoundForActiveModule(false);
            setExerciseStartedState(true);
            startOrUpdateTimer();
          }
        }, 450);
        return;
      }

      if (state.minorTimerMode === 'countdown') {
        document.getElementById('statusInlineHint').textContent =
          `🔥 ถูกต้องครบทุกช่อง! (ทำได้ ${state.sessionCompletedCount} ข้อ) กำลังไปข้อถัดไปทันที...`;
        setTimeout(() => {
          if (!state.sessionOver && state.minorTimerMode === 'countdown') {
            state.sessionQuestionIndex += 1;
            updateSessionBadgeUI();
            generateRoundForActiveModule(false);
            setExerciseStartedState(true);
            startOrUpdateTimer();
          }
        }, 450);
      } else if (state.minorTimerMode === 'fixed_count') {
        if (state.sessionCompletedCount >= state.fixedTargetCount) {
          state.sessionOver = true;
          stopTimer();
          const totalElapsedSec = state.fixedStartTimeMs ? ((performance.now() - state.fixedStartTimeMs) / 1000) : 0;
          const totalTimeStr = formatThaiDuration(totalElapsedSec);
          document.getElementById('timerDisplay').textContent = formatClock(totalElapsedSec);
          const doneMsg = `🎯 ครบทั้ง ${state.fixedTargetCount} ข้อแล้ว! เวลารวม ${totalTimeStr} • ข้อล่าสุดกดส่งไป ${state.submitAttempts} ครั้ง`;
          document.getElementById('statusInlineHint').textContent = doneMsg;

          const modalEl = document.getElementById('countdownResultModal');
          const titleEl = modalEl ? modalEl.querySelector('h2') : null;
          const compEl = document.getElementById('cdResultCompletedNum');
          const perfEl = document.getElementById('cdResultPerfectNum');
          const timeEl = document.getElementById('cdResultTimeText');
          if (titleEl) titleEl.textContent = `ทำครบ ${state.fixedTargetCount} ข้อแล้ว!`;
          if (compEl) compEl.textContent = `${state.sessionCompletedCount} ข้อ`;
          if (perfEl) perfEl.textContent = `${state.sessionPerfectCount} ข้อ`;
          if (timeEl) timeEl.textContent = `โหมดจำกัดจำนวนข้อ • เวลารวม ${totalTimeStr}`;
          if (modalEl) modalEl.classList.remove('hidden');
        } else {
          document.getElementById('statusInlineHint').textContent =
            `🎉 ผ่านข้อที่ ${state.sessionCompletedCount}/${state.fixedTargetCount} แล้ว! (กดส่งไป ${state.submitAttempts} ครั้ง) กำลังขึ้นข้อถัดไป...`;
          setTimeout(() => {
            if (!state.sessionOver) {
              state.sessionQuestionIndex += 1;
              updateSessionBadgeUI();
              generateRoundForActiveModule(false);
              setExerciseStartedState(true);
              startOrUpdateTimer();
            }
          }, 700);
        }
      }
    }

    // ลิ้นชักด้านซ้ายและสลับบทเรียน
    const sideDrawer = document.getElementById('edgeSideDrawer');
    const sideDrawerTitle = document.getElementById('edgeSideDrawerTitle');

    function closeSideDrawer() {
      state.activeSideTab = null;
      sideDrawer.classList.add('hidden');
      document.querySelectorAll('.side-rail-btn').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-slate-800/90', 'text-slate-200');
      });
    }

    function openSideDrawer(tabKey) {
      if (tabKey === 'sf_topic' && state.activeModule !== 'sharps_flats') {
        switchModule('sharps_flats');
      } else if (tabKey === 'scale_topic' && state.activeModule !== 'minor_scales') {
        switchModule('minor_scales');
      } else if (tabKey === 'chord_topic' && state.activeModule !== 'chords') {
        switchModule('chords');
      } else if (tabKey === 'interval_topic' && state.activeModule !== 'intervals') {
        switchModule('intervals');
      }

      if (state.activeSideTab === tabKey) {
        closeSideDrawer();
        return;
      }
      state.activeSideTab = tabKey;
      const titles = {
        sf_topic: 'ตั้งค่า 7 ชาร์ป 7 แฟลต',
        scale_topic: state.scaleFamily === 'major' ? 'ตั้งค่าสเกลเมเจอร์ (Major)' : 'ตั้งค่าสเกลไมเนอร์ (Minor)',
        chord_topic: 'ตั้งค่าคอร์ด (3 โน้ต / 4 โน้ต / พลิกกลับ)',
        interval_topic: 'ตั้งค่าขั้นคู่ (2–8 / ขาขึ้น-ขาลง / คุณภาพขั้นคู่)',
        timer: 'การจับเวลา & จำนวนข้อ',
        tools: 'เครื่องมือสอน & โทนสี'
      };
      sideDrawerTitle.textContent = titles[tabKey] || 'ตั้งค่า';
      sideDrawer.classList.remove('hidden');

      document.querySelectorAll('.side-rail-btn').forEach(b => {
        const active = b.getAttribute('data-sidetab') === tabKey;
        b.classList.toggle('bg-blue-600', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('bg-slate-800/90', !active);
        b.classList.toggle('text-slate-200', !active);
      });

      document.querySelectorAll('.side-drawer-panel').forEach(p => {
        p.classList.toggle('hidden', p.id !== `sidePanel_${tabKey}`);
      });
    }

    document.querySelectorAll('.side-rail-btn').forEach(btn => {
      btn.addEventListener('click', () => openSideDrawer(btn.getAttribute('data-sidetab')));
    });
    document.getElementById('btnCloseSideDrawer').addEventListener('click', closeSideDrawer);

    function switchModule(modName) {
      const keepSessionTimer = (state.minorTimerMode === 'countdown' && state.countdownEndTimeMs && !state.sessionOver)
        || (state.minorTimerMode === 'fixed_count' && state.fixedStartTimeMs && !state.sessionOver);
      if (!keepSessionTimer) {
        stopTimer();
        state.sessionOver = false;
        state.countdownEndTimeMs = null;
        state.fixedStartTimeMs = null;
        state.sessionQuestionIndex = 1;
        state.sessionCompletedCount = 0;
        state.sessionPerfectCount = 0;
      }
      stopScaleAudioSequence();
      state.activeModule = modName;
      state.submitted = false;
      state.roundCounter = 0;

      document.querySelectorAll('.module-tab-btn').forEach(btn => {
        const active = btn.getAttribute('data-module') === modName;
        btn.className = active
          ? 'module-tab-btn px-3 py-1.5 rounded-xl font-extrabold bg-blue-600 text-white shadow transition'
          : 'module-tab-btn px-3 py-1.5 rounded-xl font-bold text-slate-300 hover:bg-slate-800 hover:text-white transition';
      });

      document.querySelectorAll('.drawer-mod-btn').forEach(btn => {
        const active = btn.getAttribute('data-module') === modName;
        btn.className = active
          ? 'drawer-mod-btn w-full p-3 rounded-2xl bg-blue-600 text-white font-extrabold text-left border border-blue-400/50 transition'
          : 'drawer-mod-btn w-full p-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-extrabold text-left border border-slate-700 transition';
      });

      const isSF = modName === 'sharps_flats';
      const isMinor = modName === 'minor_scales';
      const isChords = modName === 'chords';
      const isIntervals = modName === 'intervals';
      document.getElementById('board_sharps_flats').classList.toggle('hidden', !isSF);
      document.getElementById('board_minor_scales').classList.toggle('hidden', !isMinor);
      document.getElementById('board_chords').classList.toggle('hidden', !isChords);
      document.getElementById('board_intervals').classList.toggle('hidden', !isIntervals);
      document.getElementById('btnPlayAllScalesAudio').classList.toggle('hidden', !isMinor);

      const noteRowsEl = document.getElementById('noteAnswerPad');
      const intPadEl = document.getElementById('intervalAnswerPad');
      const pickerTitleEl = document.getElementById('pickerHeaderTitleText');
