      const code = String(e.code || '').toLowerCase();
      const key = String(e.key || '').toLowerCase();
      const kc = Number(e.keyCode || e.which || 0);

      if (code === 'enter' || code === 'numpadenter' || key === 'enter' || kc === 13) {
        const submitBtn = document.getElementById('btnSubmitAnswers');
        if (state.exerciseStarted && submitBtn && !submitBtn.disabled) {
